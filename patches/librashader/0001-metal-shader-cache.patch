+    /// The reflected and compiled output of one pass, as stored in the shader cache.
+    ///
+    /// Compiling a pass means glslang (GLSL to SPIR-V), SPIRV-Cross reflection and
+    /// SPIRV-Cross MSL generation; together these are almost all of a preset's load time.
+    /// Caching the result skips all three on later loads of the same pass.
+    ///
+    /// Stored as MessagePack: the reflection holds halfbrown maps, whose `Deserialize`
+    /// calls `deserialize_any`, so it needs a self-describing format (bincode cannot
+    /// decode it).
+    #[derive(serde::Serialize, serde::Deserialize)]
+    pub struct CachedMslPass {
+        pub reflection: ShaderReflection,
+        pub vertex: String,
+        pub fragment: String,
+    }
+
+    impl Cacheable for CachedMslPass {
+        fn from_bytes(bytes: &[u8]) -> Option<Self> {
+            rmp_serde::from_slice(bytes).ok()
+        }
+
+        fn to_bytes(&self) -> Option<Vec<u8>> {
+            rmp_serde::to_vec(self).ok()
+        }
