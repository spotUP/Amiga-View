+        let reflection = reflect.reflect(index, semantics)?;
+        let msl = reflect.compile(Some(MslVersion::new(2, 0, 0)))?;
+        Ok(CachedMslPass {
+            reflection,
+            vertex: msl.vertex,
+            fragment: msl.fragment,
+        })
