+        semantics: &ShaderSemantics,
+        semantics_key: &str,
+        disable_cache: bool,
+    ) -> Result<CachedMslPass, FilterChainError> {
+        let shape = format!(
+            "{index}:{}:{}:{}",
+            source.vertex.len(),
+            source.fragment.len(),
+            semantics_key.len()
+        );
+        let keys: [&[u8]; 5] = [
+            CACHE_VERSION,
+            shape.as_bytes(),
+            source.vertex.as_bytes(),
+            source.fragment.as_bytes(),
+            semantics_key.as_bytes(),
+        ];
+        cache_shader_object(
+            "msl",
+            &keys,
+            |_| compile_pass(index, source, semantics),
+            |pass| Ok::<_, FilterChainError>(pass),
+            disable_cache,
+        )
