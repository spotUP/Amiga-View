+#[cfg(test)]
+mod cache_tests {
+    use super::compile::CachedMslPass;
+    use librashader_cache::Cacheable;
+    use librashader_common::map::FastHashMap;
+    use librashader_common::shader_features::ShaderFeatures;
+    use librashader_preprocess::ShaderSource;
+    use librashader_reflect::reflect::semantics::{
+        Semantic, ShaderSemantics, UniformSemantic, UniqueSemantics,
+    };
+
+    const SHADER: &str = r#"#version 450
+#pragma parameter STRENGTH "Strength" 0.5 0.0 1.0 0.1
+layout(std140, set = 0, binding = 0) uniform UBO { mat4 MVP; };
+layout(push_constant) uniform Push { vec4 SourceSize; float STRENGTH; } params;
+#pragma stage vertex
+layout(location = 0) in vec4 Position;
+layout(location = 1) in vec2 TexCoord;
+layout(location = 0) out vec2 vTexCoord;
+void main() { gl_Position = MVP * Position; vTexCoord = TexCoord; }
+#pragma stage fragment
+layout(location = 0) in vec2 vTexCoord;
+layout(location = 0) out vec4 FragColor;
+layout(set = 0, binding = 2) uniform sampler2D Source;
+void main() {
+    FragColor = texture(Source, vTexCoord) * params.STRENGTH + params.SourceSize.x * 0.0;
+}
+"#;
+
+    /// A cached pass must decode back from its own bytes. The reflection holds halfbrown
+    /// maps whose `Deserialize` calls `deserialize_any`; a non-self-describing format such
+    /// as bincode encodes them but never decodes them, so every load recompiled.
+    #[test]
+    fn cached_pass_round_trips_through_its_bytes() {
+        let dir = std::env::temp_dir().join(format!("mtl-cache-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("pass.slang");
+        std::fs::write(&path, SHADER).unwrap();
+        let source = ShaderSource::load(&path, ShaderFeatures::NONE).unwrap();
+        std::fs::remove_dir_all(&dir).ok();
+
+        let mut uniform_semantics = FastHashMap::default();
+        uniform_semantics.insert(
+            "STRENGTH".into(),
+            UniformSemantic::Unique(Semantic {
+                semantics: UniqueSemantics::FloatParameter,
+                index: (),
+            }),
+        );
+        let semantics = ShaderSemantics {
+            uniform_semantics,
+            texture_semantics: FastHashMap::default(),
+        };
+
+        let pass = super::compile::compile_pass_cached(0, &source, &semantics, "test", true)
+            .unwrap();
+        assert!(!pass.reflection.meta.parameter_meta.is_empty());
+        assert!(!pass.reflection.meta.unique_meta.is_empty());
+        assert!(!pass.reflection.meta.texture_meta.is_empty());
+
+        let bytes = pass.to_bytes().expect("pass encodes");
+        let decoded = CachedMslPass::from_bytes(&bytes).expect("pass decodes from its own bytes");
+        assert_eq!(decoded.vertex, pass.vertex);
+        assert_eq!(decoded.fragment, pass.fragment);
+        assert_eq!(
+            decoded.reflection.meta.parameter_meta.len(),
+            pass.reflection.meta.parameter_meta.len()
+        );
+        assert_eq!(
+            decoded.reflection.meta.texture_meta.len(),
+            pass.reflection.meta.texture_meta.len()
+        );
+    }
+}
