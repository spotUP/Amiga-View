+    /// The semantics as stable text for the cache key. The maps are hash maps whose
+    /// iteration order is not guaranteed, so the entries are sorted first.
+    pub fn semantics_key(semantics: &ShaderSemantics) -> String {
+        let mut entries: Vec<String> = semantics
